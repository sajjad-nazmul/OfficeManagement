@page "/touristplaces/details"
@using Microsoft.EntityFrameworkCore
@using OfficeManagement.Data
@using OfficeManagement.Services

@inject ITouristPlaceService touristPlaceService
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>TouristPlace</h2>
    <hr />
    @if (touristplace is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@touristplace.Name</dd>
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@touristplace.Address</dd>
            <dt class="col-sm-2">Rating</dt>
            <dd class="col-sm-10">@touristplace.Rating</dd>
            <dt class="col-sm-2">Image</dt>
            <dd class="col-sm-10">
                <img height="90" src="@(touristplace.ImageUrl)" />
            </dd>
        </dl>
        <div>
            <AuthorizeView Roles="Admin, Moderator">
                <a href="@($"/touristplaces/edit?id={touristplace.Id}")">Edit</a> |
            </AuthorizeView>
            <a href="@($"/touristplaces")">Back to List</a>
        </div>
    }
</div>

@code {
    private TouristPlace? touristplace;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        touristplace = await touristPlaceService.GetTouristPlace(Id);

        if (touristplace is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
