@page "/touristplaces/delete"
@using Microsoft.EntityFrameworkCore
@using OfficeManagement.Data
@using OfficeManagement.Services

@inject ITouristPlaceService touristPlaceService
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>TouristPlace</h2>
    <hr />
    @if (touristplace is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@touristplace.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@touristplace.Address</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Rating</dt>
            <dd class="col-sm-10">@touristplace.Rating</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Image</dt>
            <dd class="col-sm-10">
                <img height="90" src="@(touristplace.ImageUrl)" />
            </dd>
        </dl>
        <EditForm method="post" Model="touristplace" OnValidSubmit="DeleteTouristPlace" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(touristplace is null)">Delete</button> |
            <a href="/touristplaces">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TouristPlace? touristplace;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        touristplace = await touristPlaceService.GetTouristPlace(Id);

        if (touristplace is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTouristPlace()
    {
        await touristPlaceService.DeleteTouristPlace(touristplace!);
        NavigationManager.NavigateTo("/touristplaces");
    }
}
